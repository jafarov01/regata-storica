/**
 * src/scene/hud.ts
 * The big-screen HUD as a DOM overlay (SPEC section 10): absolutely positioned divs that
 * mirror the layout rects, pointer-events none, team colours from the CSS variables in
 * src/styles/base.css. Text, borders, the crosshair (SVG), the kill-cam card, the shield flash
 * and the minimap canvas live here; the WebGL canvas never draws UI. Per-cell corner widgets
 * are pushed away from the scoreboard band and the centre minimap by layout.placeWidget().
 */
import { bowArrowAngle } from './camera.ts';
import { computeLayout, placeWidget, type Layout, type Rect } from './layout.ts';
import { MapPainter } from './minimap.ts';
import type { MapGrid } from '@shared/map.ts';
import type { BoatState, GameEvent, RenderState, TeamState } from '@shared/state.ts';

