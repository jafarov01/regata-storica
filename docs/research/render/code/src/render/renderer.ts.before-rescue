/**
 * src/render/renderer.ts
 * createRenderer(canvas, map) -> { render(state, events, layout, alpha), resize(), dispose() }.
 * One WebGLRenderer, one Scene, one camera rig per team. Per frame: clear the whole canvas once
 * (scissor off), then for each team set viewport + scissor and render. The shadow map is baked
 * once at load (shadowMap.autoUpdate = false, needsUpdate = true once); three resets needsUpdate
 * at the end of the first shadow pass, so the other viewports in the same frame reuse it.
 * Entities are pooled: boats in a Map keyed by sim id (create/remove on diff), crates, projectiles
 * and mines in InstancedMesh pools whose `count` is set each frame. No per-frame allocation.
 */
import {
  BoxGeometry,
  Color,
  ConeGeometry,
  CylinderGeometry,
  InstancedMesh,
  Matrix4,
  MeshBasicMaterial,
  MeshStandardMaterial,
  Object3D,
  PCFShadowMap,
  Scene,
  SphereGeometry,
  Timer,
  Vector3,
  WebGLRenderer,
} from 'three';
import { lerp } from '@shared/math.ts';
import type { MapGrid } from '@shared/map.ts';
import type { GameEvent, RenderState } from '@shared/state.ts';
import { CameraRig } from '../scene/camera.ts';
import { inset, toGlViewport, type Layout } from '../scene/layout.ts';
import { GameAudio } from './audio.ts';
import { buildWorld, cullByDistance, type World } from './buildings.ts';
import { setupEnvironment, type Environment } from './environment.ts';
import { GondolaView, createGondolaAssets, type GondolaAssets } from './gondola.ts';
import { PerfMonitor, QUALITY, type QualitySettings } from './perf.ts';
import { makeGlowTexture, makeGrainTexture, makeStripeTexture, makeWaterNormalTexture } from './textures.ts';
import { Vfx } from './vfx.ts';
import { createWater, type WaterSurface } from './water.ts';

export interface RendererOptions {
  /** Poly Haven HDRI, loaded after the first frame. null = keep the procedural sky. */
  readonly hdriUrl?: string | null;
  readonly perfParent?: HTMLElement;
  readonly initialQuality?: number;
}

export interface GameRenderer {
  render(state: RenderState, events: readonly GameEvent[], layout: Layout, alpha: number): void;
  resize(): void;
  dispose(): void;
  setQuality(index: number): void;
  readonly quality: number;
  readonly perf: PerfMonitor;
  readonly audio: GameAudio;
  readonly scene: Scene;
  readonly renderer: WebGLRenderer;
}

const POOL = { crates: 32, projectiles: 64, mines: 32, jets: 6 } as const;
const CRATE_COLOURS = { weapon: new Color(0xff3a2a), power: new Color(0x2a8cff) } as const;
const HIDDEN = new Matrix4().makeScale(0, 0, 0);
const tmpM = new Matrix4();
const tmpV = new Vector3();
const dummy = new Object3D();

export function createRenderer(canvas: HTMLCanvasElement, map: MapGrid, options: RendererOptions = {}): GameRenderer {
  const renderer = new WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance', stencil: false, alpha: false });
  renderer.setPixelRatio(1); // 4 viewports at 1080p are 960 x 540 each; an integer DPR also keeps setViewport (round) and setRenderTarget (floor) in step
  renderer.autoClear = false; // we clear the whole canvas once per frame, then render every viewport
  renderer.info.autoReset = false; // otherwise info resets on every render() and only shows the last viewport
  renderer.setClearColor(0x05101a, 1);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = PCFShadowMap; // PCFSoftShadowMap is removed in r186's WebGLShadowMap (warns and falls back)
  renderer.shadowMap.autoUpdate = false;
  renderer.shadowMap.needsUpdate = true; // bake once on the first frame; reset by WebGLShadowMap.render

  const scene = new Scene();
  const maxAniso = renderer.capabilities.getMaxAnisotropy();
  const aniso = Math.min(8, maxAniso);
  const textures = {
    waterNormal: makeWaterNormalTexture(256, aniso),
    grain: makeGrainTexture(256, 0.18, aniso),
    glow: makeGlowTexture(64),
    stripesBlue: makeStripeTexture('#f3f0e6', '#2b5fb8'),
    stripesRed: makeStripeTexture('#f3f0e6', '#b8362b'),
    shirt: makeStripeTexture('#f6f3ea', '#1f3a7a', 10),
  };
  const env: Environment = setupEnvironment(renderer, scene, new Vector3(0, 0, 0));
  const water: WaterSurface = createWater(textures.waterNormal);
  scene.add(water.mesh);
  const world: World = buildWorld(map, textures);
  scene.add(world.group);
  const vfx = new Vfx(textures.glow);
  scene.add(vfx.group);
  const audio = new GameAudio();
  const assets: GondolaAssets = createGondolaAssets(textures.glow, { shirt: textures.shirt });
  const perf = new PerfMonitor(options.perfParent ?? document.body);
  const timer = new Timer();

  // ---- pools ---------------------------------------------------------------
  const crateGeo = new BoxGeometry(1.3, 1.0, 1.3);
  const crateMat = new MeshStandardMaterial({ color: 0x8b6a3e, roughness: 0.9 });
  const crates = new InstancedMesh(crateGeo, crateMat, POOL.crates);
  const lanternGeo = new BoxGeometry(0.35, 0.45, 0.35).translate(0, 0.85, 0);
  const lanternMat = new MeshBasicMaterial({ color: 0xffffff, toneMapped: false }); // tinted per instance, unlit so it glows
  const lanterns = new InstancedMesh(lanternGeo, lanternMat, POOL.crates);
  const shotGeo = new SphereGeometry(0.22, 10, 8);
  const shotMat = new MeshStandardMaterial({ color: 0x222226, roughness: 0.4, metalness: 0.7 });
  const shots = new InstancedMesh(shotGeo, shotMat, POOL.projectiles);
  const mineGeo = new SphereGeometry(0.45, 10, 8);
  const mineMat = new MeshStandardMaterial({ color: 0xffffff, roughness: 0.6 });
  const mines = new InstancedMesh(mineGeo, mineMat, POOL.mines);
  const jetGeo = new ConeGeometry(0.6, 9, 10, 1, true).rotateZ(Math.PI / 2).translate(4.5, 0, 0);
  const jetMat = new MeshBasicMaterial({ color: 0x9fd8ff, transparent: true, opacity: 0.45, depthWrite: false });
  const jets = new InstancedMesh(jetGeo, jetMat, POOL.jets);
  for (const im of [crates, lanterns, shots, mines, jets]) {
    im.frustumCulled = false; // dynamic pools: the auto bounding sphere would go stale
    im.count = 0;
    scene.add(im);
  }
  const unusedGeo = new CylinderGeometry(1, 1, 1); // keeps the import honest for the GLB-less build; removed when crates get a model
  unusedGeo.dispose();

  const boats = new Map<number, GondolaView>();
  const rigs = new Map<number, CameraRig>();
  const seen = new Set<number>();
  let qualityIndex = Math.max(0, Math.min(QUALITY.length - 1, options.initialQuality ?? 0));
  let settings: QualitySettings = QUALITY[qualityIndex] ?? QUALITY[0]!;
  let hdriStarted = false;
  let frame = 0;

  function applyQuality(): void {
    settings = QUALITY[qualityIndex] ?? QUALITY[0]!;
    renderer.shadowMap.enabled = settings.shadows;
    if (settings.shadows) renderer.shadowMap.needsUpdate = true; // re-bake when shadows come back
    for (const o of world.detail) o.visible = settings.detail;
    renderer.setPixelRatio(settings.pixelRatio);
    resize();
  }

  function resize(): void {
    const w = canvas.clientWidth || window.innerWidth;
    const h = canvas.clientHeight || window.innerHeight;
    renderer.setSize(w, h, false); // CSS size is owned by the stylesheet (100vw x 100vh)
  }

  function rigFor(teamId: number): CameraRig {
    let rig = rigs.get(teamId);
    if (!rig) {
      rig = new CameraRig(map);
      rigs.set(teamId, rig);
    }
    return rig;
  }

  function syncBoats(state: RenderState, alpha: number, time: number, dt: number): void {
    seen.clear();
    for (const b of state.boats) {
      seen.add(b.id);
      let view = boats.get(b.id);
      if (!view) {
        const team = state.teams.find((t) => t.id === b.team);
        view = new GondolaView(assets, team?.colour ?? 0xffffff, textures.glow);
        boats.set(b.id, view);
        scene.add(view.root);
      }
      view.update(b, alpha, time, dt);
    }
    for (const [id, view] of boats) {
      if (seen.has(id)) continue;
      scene.remove(view.root);
      view.dispose();
      boats.delete(id);
    }
  }

  function syncPools(state: RenderState, alpha: number, time: number): void {
    let n = 0;
    for (const c of state.crates) {
      if (n >= POOL.crates) break;
      if (c.active) {
        dummy.position.set(c.x, 0.1 + Math.sin(time * 1.1 + c.id) * 0.08, c.z);
        dummy.rotation.set(0, time * 0.3 + c.id, Math.sin(time * 0.9 + c.id) * 0.06);
        dummy.updateMatrix();
        crates.setMatrixAt(n, dummy.matrix);
        lanterns.setMatrixAt(n, dummy.matrix);
      } else {
        crates.setMatrixAt(n, HIDDEN);
        lanterns.setMatrixAt(n, HIDDEN);
      }
      lanterns.setColorAt(n, c.kind === 'weapon' ? CRATE_COLOURS.weapon : CRATE_COLOURS.power);
      n++;
    }
    crates.count = n;
    lanterns.count = n;
    crates.instanceMatrix.needsUpdate = true;
    lanterns.instanceMatrix.needsUpdate = true;
    if (lanterns.instanceColor) lanterns.instanceColor.needsUpdate = true;

    n = 0;
    for (const p of state.projectiles) {
      if (n >= POOL.projectiles) break;
      dummy.position.set(lerp(p.px, p.x, alpha), lerp(p.py, p.y, alpha), lerp(p.pz, p.z, alpha));
      dummy.rotation.set(0, -p.yaw, 0);
      dummy.scale.set(p.kind === 'torpedo' ? 3.5 : 1, 1, 1);
      dummy.updateMatrix();
      shots.setMatrixAt(n, dummy.matrix);
      n++;
    }
    dummy.scale.set(1, 1, 1);
    shots.count = n;
    shots.instanceMatrix.needsUpdate = true;

    n = 0;
    for (const m of state.mines) {
      if (n >= POOL.mines) break;
      tmpM.makeTranslation(m.x, -0.12 + Math.sin(time * 1.5 + m.id) * 0.05, m.z);
      mines.setMatrixAt(n, tmpM);
      mines.setColorAt(n, m.armed ? CRATE_COLOURS.weapon : CRATE_COLOURS.power);
      n++;
    }
    mines.count = n;
    mines.instanceMatrix.needsUpdate = true;
    if (mines.instanceColor) mines.instanceColor.needsUpdate = true;

    n = 0;
    for (const j of state.jets) {
      if (n >= POOL.jets) break;
      dummy.position.set(j.x, 0.7, j.z);
      dummy.rotation.set(0, -j.yaw, 0);
      dummy.updateMatrix();
      jets.setMatrixAt(n, dummy.matrix);
      n++;
    }
    jets.count = n;
    jets.instanceMatrix.needsUpdate = true;
  }

  function updateRig(rig: CameraRig, teamBoatId: number, state: RenderState, dt: number): void {
    const own = boats.get(teamBoatId);
    const ownState = state.boats.find((b) => b.id === teamBoatId);
    if (!own || !ownState) return;
    if (!ownState.alive && ownState.killerBoatId !== null) {
      const killerState = state.boats.find((b) => b.id === ownState.killerBoatId);
      const killer = killerState ? boats.get(killerState.id) : undefined;
      if (killerState && killer && killerState.alive) {
        rig.update({ x: killer.ix, z: killer.iz, aim: killer.iyaw }, dt, 'killcam');
        return;
      }
    }
    rig.update({ x: own.ix, z: own.iz, aim: own.iaim }, dt, 'follow');
  }

  function render(state: RenderState, events: readonly GameEvent[], layout: Layout, alpha: number): void {
    timer.update();
    const dt = Math.min(0.1, timer.getDelta());
    const time = timer.getElapsed();
    frame++;
    renderer.info.reset();
    if (settings.dynamicShadows && settings.shadows) renderer.shadowMap.needsUpdate = true;
    if (!hdriStarted && frame > 2 && options.hdriUrl) {
      hdriStarted = true;
      void env.applyHdri(options.hdriUrl);
    }

    water.update(time);
    syncBoats(state, alpha, time, dt);
    syncPools(state, alpha, time);
    vfx.onEvents(events, state, time);
    vfx.update(time);
    audio.onEvents(events, state, time);

    renderer.setScissorTest(false);
    renderer.clear(true, true, false); // the whole canvas once: viewports are disjoint, so one depth clear is enough

    renderer.setScissorTest(true);
    let viewports = 0;
    for (let i = 0; i < state.teams.length; i++) {
      const team = state.teams[i];
      const cell = layout.cells[i];
      if (!team || !cell) continue;
      const r = toGlViewport(inset(cell, layout.border), layout.height);
      renderer.setViewport(r.x, r.y, r.w, r.h);
      renderer.setScissor(r.x, r.y, r.w, r.h);
      const rig = rigFor(team.id);
      rig.setAspect(r.w / r.h);
      updateRig(rig, team.boatId, state, dt);
      rig.camera.getWorldPosition(tmpV);
      cullByDistance(world.cullables, tmpV, settings.cullDistance);
      vfx.setViewport(r.h, rig.camera.fov);
      renderer.render(scene, rig.camera);
      viewports++;
    }
    renderer.setScissorTest(false);
    if (perf.sample(renderer, dt, time, viewports, settings.name) && qualityIndex < QUALITY.length - 1) {
      qualityIndex++;
      applyQuality();
    }
  }

  function dispose(): void {
    for (const view of boats.values()) view.dispose();
    boats.clear();
    for (const g of [crateGeo, lanternGeo, shotGeo, mineGeo, jetGeo]) g.dispose();
    for (const m of [crateMat, lanternMat, shotMat, mineMat, jetMat]) m.dispose();
    for (const im of [crates, lanterns, shots, mines, jets]) im.dispose();
    for (const t of Object.values(textures)) t.dispose();
    water.dispose();
    world.dispose();
    vfx.dispose();
    audio.dispose();
    assets.dispose();
    env.dispose();
    timer.dispose();
    renderer.dispose();
  }

  canvas.addEventListener('webglcontextlost', (e) => {
    e.preventDefault();
    console.error('WebGL context lost; reload the scene page');
  });

  applyQuality();

  return {
    render,
    resize,
    dispose,
    setQuality(index: number): void {
      qualityIndex = Math.max(0, Math.min(QUALITY.length - 1, index));
      applyQuality();
    },
    get quality(): number {
      return qualityIndex;
    },
    perf,
    audio,
    scene,
    renderer,
  };
}
