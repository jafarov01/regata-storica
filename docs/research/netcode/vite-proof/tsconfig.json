{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "noUncheckedIndexedAccess": true,
    "isolatedModules": true, "skipLibCheck": true, "esModuleInterop": true, "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["main.ts", "vite.config.ts"]
}
