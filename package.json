{
  "name": "gondola-royale",
  "version": "0.1.0",
  "private": true,
  "description": "Gondola Royale: a browser party deathmatch. Phones are the controllers, one PC renders the game.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n vite,relay -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:https": "HTTPS=1 npm run dev",
    "dev:vite": "vite",
    "dev:relay": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "npm run build && npm run start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "tunnel:prod": "cloudflared tunnel --url http://localhost:3000",
    "test:relay": "vitest run tests/relay.test.ts"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.21.0",
    "express": "^5.3.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
